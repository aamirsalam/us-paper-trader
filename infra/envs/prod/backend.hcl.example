# Only needed if you move state to S3 (see backend_s3.tf.example). Copy to backend.hcl (git-ignored).
# The separate key keeps this state independent of any other stack's.
bucket       = "YOUR-TF-STATE-BUCKET"
key          = "us-paper-trader/prod/terraform.tfstate"
region       = "ap-southeast-2"
encrypt      = true
use_lockfile = true
