# Copy to terraform.tfvars (git-ignored) and adjust.
# Budget alerts and "a run failed" alerts go here. AWS sends a confirmation email first: click it.
alert_email = "you@example.com"

# SEC asks for a contact. Needed from day one: Nasdaq's calendar often refuses cloud servers,
# and without this fallback the aggressive mode can't buy single stocks.
sec_user_agent = "Your Name you@example.com"

# Leave false for the first apply. Turn on after secrets are set and a manual run passes.
schedules_enabled = false

# Account guardrails: run .\scripts\preflight.ps1 first; it tells you which of these to flip.
use_default_vpc          = false # true if creating a VPC is blocked (the NSE stack uses the default VPC)
use_permissions_boundary = true  # false if creating managed IAM policies is blocked

# GitHub-to-AWS login (OIDC). Leave both off if the account blocks it (free-plan accounts do):
# push the image from your laptop with .\scripts\push-image.ps1 instead of the deploy workflow.
github_oidc_provider_arn    = ""
create_github_oidc_provider = false

# Optional: plug in your real bank's FX markup and per-remittance charges.
app_env = {
  FX_SPREAD_PCT      = "0.0075"
  REMITTANCE_FEE_INR = "0"
  # AI veto: confidence needed to block a buy (default 0.6); pin models if you like, else newest Flash-Lite/Flash.
  # AI_VETO_CONFIDENCE = "0.6"
  # GEMINI_MODELS      = "gemini-2.5-flash-lite,gemini-2.5-flash"
  # Your marginal income-tax rate, for the after-tax column (default 0.30).
  # TAX_SLAB_RATE = "0.30"
  # Loss-limit overrides (fractions, or "off"). Defaults are in strategies/__init__.py.
  # RISK_AGGRESSIVE_DRAWDOWN = "0.20"
  # RISK_AGGRESSIVE_HALT_DAYS = "20"
}
